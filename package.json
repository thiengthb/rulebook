{
  "name": "@thiengthb/rulebook",
  "version": "0.1.0",
  "private": true,
  "description": "Serves the platform rulebook as VERDICTS, not text — tier-2 delivery (idea-0023).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/http.js",
    "dev": "tsc -p tsconfig.build.json && node dist/server/http.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
